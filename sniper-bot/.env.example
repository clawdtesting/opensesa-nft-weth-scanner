# ===========================================================================
# Robinhood Chain up. DEX sniper — configuration
# Copy to `.env` and fill in. NEVER commit your real .env.
# ===========================================================================

# --- RPC endpoints ---------------------------------------------------------
# WebSocket is strongly preferred for real-time PairCreated/PoolCreated events.
# Get one from Alchemy (https://alchemy.com) or QuickNode for Robinhood Chain.
# Example Alchemy WSS: wss://robinhood-mainnet.g.alchemy.com/v2/YOUR_KEY
RPC_WS=""
# HTTP endpoint (used for sending the buy tx and as a polling fallback).
# Falls back to the public RPC if left empty (rate-limited — not ideal).
RPC_HTTP="https://rpc.mainnet.chain.robinhood.com"

# --- Wallet ----------------------------------------------------------------
# Private key of a DEDICATED hot wallet, funded with ETH for the buy + gas.
# Anyone with this key controls the wallet — use a burner with limited funds.
PRIVATE_KEY=""

# --- Target(s) -------------------------------------------------------------
# One address, or several comma-separated for multi-token monitoring.
TARGET_TOKENS="0xe3fa12da7fa026b21817f16622e8ae48fa785166"

# --- Buy parameters --------------------------------------------------------
BUY_AMOUNT_ETH="0.05"
SLIPPAGE_BPS="500"          # 500 = 5%
MAX_GAS_GWEI="5"            # skip/wait if network gas price exceeds this
GAS_LIMIT="500000"          # optional hard cap; empty = estimate
DEADLINE_SECONDS="60"       # tx deadline from send time

# DRY_RUN=true simulates the buy (no funds spent) and logs the expected output.
# Set to false ONLY once you've verified addresses and a dry run looks correct.
DRY_RUN="true"

# --- Robinhood chain constants ---------------------------------------------
WETH_ADDRESS="0x0Bd7D308f8E1639FAb988df18A8011f41EAcAD73"

# --- DEX addresses (VERIFY on the explorer — see README) -------------------
# Router style: "velodrome" (ve(3,3) route with factory field, up.'s likely style),
# "solidly" (classic route without factory), "univ2", or "univ3".
ROUTER_STYLE="velodrome"
UP_ROUTER=""                # up. router address
# Factory addresses to watch for pool creation (comma-separated allowed).
UP_V2_FACTORY=""            # up. PairFactory (ve(3,3)/v2-style PairCreated)
UP_V3_FACTORY=""            # up. CL/v3 factory (PoolCreated), if it has one
EXTRA_V2_FACTORIES=""       # any other Uniswap-V2-style factories, comma-separated
EXTRA_V3_FACTORIES=""       # any other Uniswap-V3-style factories, comma-separated
# For velodrome-style routes, the pool factory the route should use (often UP_V2_FACTORY).
ROUTE_FACTORY=""
# Try a stable pool first? Usually false for a fresh volatile token.
STABLE_POOL="false"
# univ3 only: fee tier (e.g. 3000 = 0.3%) + quoter for minOut.
UNIV3_FEE="3000"
UNIV3_QUOTER=""
UNIV3_SWAP_ROUTER=""

# --- Backup discovery (optional) -------------------------------------------
# Poll Dexscreener for new pairs involving the token as a fallback to events.
DEXSCREENER_ENABLED="true"
DEXSCREENER_POLL_MS="4000"
# Dexscreener chain slug for Robinhood Chain (verify at dexscreener.com; may be
# empty if not yet listed — the token-search endpoint still works chain-agnostically).
DEXSCREENER_CHAIN=""

# --- Notifications (optional) ----------------------------------------------
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
DISCORD_WEBHOOK=""

# --- Take-profit (optional, simple) ----------------------------------------
# After buying, if price reaches TAKE_PROFIT_MULT x entry, sell SELL_PCT of the
# holding. 0/empty disables. (Best-effort; verify before relying on it.)
TAKE_PROFIT_MULT=""         # e.g. 3  (3x)
SELL_PCT="50"               # percent of tokens to sell at take-profit
