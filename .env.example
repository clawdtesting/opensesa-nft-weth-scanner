# ---------------------------------------------------------------------------
# Database (PostgreSQL) — required
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/opensea_scanner?schema=public"

# ---------------------------------------------------------------------------
# OpenSea API — required for live data ingestion
# Get a key at https://docs.opensea.io/reference/api-keys
# SERVER-SIDE ONLY. Never prefix with NEXT_PUBLIC_.
# ---------------------------------------------------------------------------
OPENSEA_API_KEY=""
# Base URL for the OpenSea REST API (v2). Override only for testnets.
OPENSEA_API_BASE="https://api.opensea.io/api/v2"
# Chain to scan (opensea chain identifier): ethereum, matic, base, etc.
OPENSEA_CHAIN="ethereum"
# Max OpenSea requests per second (client-side throttle; OpenSea default is ~4/s)
OPENSEA_MAX_RPS="4"

# ---------------------------------------------------------------------------
# Scanner behaviour (all optional — sensible defaults in src/config)
# ---------------------------------------------------------------------------
# Comma-separated collection slugs to always scan in addition to discovery.
SCAN_SEED_SLUGS=""
# How many top-volume collections discovery should consider each cycle.
DISCOVERY_LIMIT="60"

# ---------------------------------------------------------------------------
# Redis / BullMQ (OPTIONAL — not required to run V1)
# ---------------------------------------------------------------------------
REDIS_URL=""

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
PORT=3000
NODE_ENV=development
